# Application
APP_NAME=my-notes-api
APP_PORT=3000
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=notesuser
DB_PASS=yourpassword
DB_NAME=my_notes_api

# JWT Secret (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-this-in-production

# JWT Expiration
JWT_ACCESS_TOKEN_EXP=15m
JWT_REFRESH_TOKEN_EXP=7d

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (untuk phase selanjutnya)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
