# Application Configuration
APP_ENV=development
APP_PORT=3000
APP_NAME=my-notes-api

# Database Configuration
# Gunakan MySQL untuk production, SQLite untuk development juga bisa
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=my_notes_db

# Database Connection Pool
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600

# JWT Configuration
# PENTING: Generate JWT_SECRET yang kuat dengan command:
# go run scripts/generate-secret.go
# atau: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHARS_STRING
JWT_ACCESS_TOKEN_DURATION=15m
JWT_REFRESH_TOKEN_DURATION=7d

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
BCRYPT_COST=12

# Redis (optional, untuk distributed rate limiting & caching)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
